# 4G Trip Environment Variables
# Copy this file to .env.local or .env for local development

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for frontend exposure, subject to RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Application Title & Base Configuration
VITE_APP_TITLE=4G Trip
VITE_APP_CURRENCY=IDR
